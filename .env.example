# Copy this file to .env and fill in real values -- .env itself is
# gitignored and never committed.

# --- Django core -------------------------------------------------------
SECRET_KEY=
ALLOWED_HOSTS=gapsit.bd,www.gapsit.bd

# --- Database: MySQL -----------------------------------------------------
# Leave DB_ENGINE unset (or blank) to fall back to sqlite3 instead.
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- CORS ----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://gapsit.bd/core,https://www.gapsit.bd/core

# --- Admin API key (used by EmployeeViewSet.verify_admin) ---------------
ADMIN_API_KEY=

# --- GapsSight downloads (see apps/releases/) -----------------------------
GAPSIGHT_RELEASES_DIR=releases_files
GAPSIGHT_DOWNLOAD_TOKEN_MINUTES=10
